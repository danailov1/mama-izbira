  "reviews": [
    { "product": "chicco-goody", "author": "maria", "rating": 5, "text": "Много лека и се сгъва с една ръка. Влиза спокойно в багажника на малка кола и е удобна за градския транспорт." },
    { "product": "chicco-goody", "author": "nikolay", "rating": 4, "text": "Добра стойка и стабилно возене по павета. Единственото ми забележка е малката кошница за покупки." },
    { "product": "chicco-goody", "author": "admin", "rating": 5, "text": "Страхотно съотношение цена-качество за ежедневна употреба. Бебето спи спокойно дори по-дълги разходки." },
    { "product": "cybex-cloud-z", "author": "ivelina", "rating": 5, "text": "Много добро странично покритие и стабилна основа ISOFIX. Монтажът отнема под минута и стои сигурно." },
    { "product": "cybex-cloud-z", "author": "gabriela", "rating": 4, "text": "Удобна е за новородено, но е малко тежка при носене на ръка. Иначе качеството си личи." },
    { "product": "maxi-cosi-pearl", "author": "ivelina", "rating": 4, "text": "Разтяга се на много позиции и детето не се оплаква при дълги пътувания. Свалянето от основата е лесно." },
    { "product": "maxi-cosi-pearl", "author": "maria", "rating": 5, "text": "Използваме я вече година и изглежда като нова. Много стабилна при спиране и завиване." },
    { "product": "britax-advansafix", "author": "nikolay", "rating": 5, "text": "Инсталацията с ISOFIX и горен колан дава усещане за много добра защита. Препоръчвам за по-големи деца." },
    { "product": "joie-stages-fx", "author": "maria", "rating": 3, "text": "Върши работа за цената си, но тапицерията лесно се нацапва и е трудна за сваляне при пране." },
    { "product": "joie-stages-fx", "author": "admin", "rating": 4, "text": "Лесна за регулиране и надеждна за ежедневно шофиране. Кошницата е малка, но за кратък път е ок." },
    { "product": "peg-perego-siesta", "author": "ivelina", "rating": 5, "text": "Пет позиции за облегалка и стъпало — детето седи изправено и вечеря с нас спокойно на масата." },
    { "product": "peg-perego-siesta", "author": "gabriela", "rating": 5, "text": "Стабилна, лесно се почиства и колелцата се плъзгат безшумно. Най-доброто столче, което сме ползвали." },
    { "product": "stokke-tripp-trapp", "author": "ivelina", "rating": 5, "text": "Расте с детето и реално се ползва години. След втората година стъпалото се мести и стойката е правилна." },
    { "product": "stokke-tripp-trapp", "author": "maria", "rating": 4, "text": "Класика, която наистина издържа. Скъпа е, но ако я ползваш две деца, си заслужава." },
    { "product": "philips-avent-natural", "author": "maria", "rating": 4, "text": "Бебето я прие веднага и не се задушава с коляното. Единствено миещите части са повече." },
    { "product": "philips-avent-natural", "author": "nikolay", "rating": 5, "text": "Силиконът е мек и не задържа миризми след стерилизация. Купихме втори комплект за ходене на гости." },
    { "product": "mam-easy-start", "author": "gabriela", "rating": 3, "text": "Клапанът за антиколик помага при въздух, но затягането на капачката става след няколко опита." },
    { "product": "mam-easy-start", "author": "admin", "rating": 4, "text": "Добър избор при колики. Дъното се разглобява лесно и се стерилизира безопасно." },
    { "product": "tommee-tippee-closer", "author": "ivelina", "rating": 4, "text": "Широкото гърло улеснява миенето и прилича на гърда, което помогна с прехода от кърмене." },
    { "product": "hipp-combiotik-2", "author": "maria", "rating": 5, "text": "Детето нямаше проблеми със стомаха и премина към нея без отказ. Приятен вкус за формула." },
    { "product": "hipp-combiotik-2", "author": "gabriela", "rating": 4, "text": "Разтваря се бързо без бучки и опаковката с мерителна лъжичка е удобна за приготвяне." },
    { "product": "aptamil-profutura-2", "author": "ivelina", "rating": 4, "text": "Минахме към нея след препоръка от педиатър и оттогава сънят е по-спокоен вечер." },
    { "product": "gerber-oatmeal", "author": "nikolay", "rating": 4, "text": "Смесва се лесно с вода или мляко и детето я прие без гримаси. Удобна за пътуване." },
    { "product": "hipp-fruit-puree", "author": "gabriela", "rating": 5, "text": "Без добавена захар и вкусът е наистина плодов. Удобна доза за между храненията." },
    { "product": "lego-duplo-farm", "author": "ivelina", "rating": 5, "text": "Големите блокчета са идеални за малки ръчички и въображението работи с часове. Издръжливи са." },
    { "product": "lego-duplo-farm", "author": "maria", "rating": 5, "text": "Има животинки и фигурки, които задържат вниманието. Почистването е бързо с влажна кърпа." },
    { "product": "fisher-jumperoo", "author": "nikolay", "rating": 4, "text": "Много забавна за бебето и развива координацията. Заема доста място в хола обаче." },
    { "product": "fisher-jumperoo", "author": "admin", "rating": 4, "text": "Регулира се на височина и е стабилна при подскачане. Музиката е приятна, но можеше и по-тиха." }
  ],
